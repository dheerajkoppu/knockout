# Where the Knockout API runs (FastAPI, src/knockout/api.py). Inlined at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Sentry Session Replay and tracing for the web page; leave empty to turn Sentry off.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Send Sentry trace headers to the API, so browser and API spans join one trace.
NEXT_PUBLIC_SENTRY_TRACE_API=false
# Show the labelled development fixture instead of calling the API (same as ?fixture=1).
NEXT_PUBLIC_USE_FIXTURES=false
