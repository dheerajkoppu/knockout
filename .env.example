# Copy to .env (gitignored) and fill in. Never commit real keys.
# The web page reads web/.env.example, the Fetch.ai agents read agents/.env.example, and the Vultr
# deployment reads deploy/vultr.env.example (the complete list for the server).

# Engine
# Google AI Studio key, used for phenotype classification and mapping (protocol step 5)
GEMINI_API_KEY=
# Optional: a specific model; when empty the newest Gemini flash model is used
GEMINI_MODEL=
# Optional for single drugs, needed for the benchmark (openFDA allows 1,000 requests a day without one)
OPENFDA_API_KEY=
# Hours an openFDA label or total stays cached on disk (default 24); ?refresh=true always refetches
OPENFDA_CACHE_HOURS=

# Store: empty uses JSON files under data/store/. Set to a Tiger Data (TimescaleDB) connection string, or
# postgresql://knockout:knockout@127.0.0.1:5433/knockout for the local `docker compose up -d timescaledb`
DATABASE_URL=
# Where the file store keeps its JSON (default data/store/)
KNOCKOUT_STORE_DIR=
# Only for tests/test_store.py against a different database than DATABASE_URL
KNOCKOUT_TEST_DATABASE_URL=
# Local TimescaleDB container (docker-compose.yml)
POSTGRES_PASSWORD=
TIMESCALEDB_PORT=

# API
# Shared secret for POST /api/webhooks/creao/signals; the same value goes into Creao Secrets.
# Once set, POST /api/watchlist and ?refresh=true also need it in the X-Knockout-Webhook-Secret header.
KNOCKOUT_WEBHOOK_SECRET=
# Extra browser origins, comma separated (localhost:3000, 127.0.0.1:3000 and https://*.vercel.app are always allowed)
KNOCKOUT_ALLOWED_ORIGINS=

# Sentry (API and agents); nothing is sent when SENTRY_DSN is empty
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=1.0

# Creao watch agent (creao/watch.py reads the first two; creao/trigger.py, server side only, the last two)
KNOCKOUT_API_URL=
WATCH_QUARTERS=
CREAO_API_KEY=
CREAO_AGENT_ID=
