# Copy to agents/.env (gitignored). Never commit real seeds or keys.

# The Knockout API the specialists call
KNOCKOUT_API_URL=http://localhost:8000
# Optional: the report page, linked from the full report
KNOCKOUT_REPORT_PAGE_URL=

# One long random phrase per agent; each address is derived from its seed. Make them with:
#   python -m knockout_agents.seeds >> .env
AGENT_SEED_ORCHESTRATOR=
AGENT_SEED_TARGET=
AGENT_SEED_GENETICS=
AGENT_SEED_LABEL=
AGENT_SEED_SIGNAL=

# true: every agent connects through an Agentverse mailbox; orchestrator: only knockout-orchestrator does (the
# one ASI:One talks to; the specialists stay reachable in the same process); false: local only
AGENT_MAILBOX=true
# The one process that runs all five agents listens here (the Agent Inspector connects to it)
KNOCKOUT_AGENTS_PORT=8100
# Agentverse API key, read only by `python -m knockout_agents.connect`
AGENTVERSE_API_KEY=
# Only when a specialist runs in another process or on Agentverse: its address
AGENT_ADDRESS_TARGET=
AGENT_ADDRESS_GENETICS=
AGENT_ADDRESS_LABEL=
AGENT_ADDRESS_SIGNAL=

# Payment Protocol: the summary is free, the full report costs this much FET per drug
KNOCKOUT_PAYMENT_ENABLED=true
KNOCKOUT_FULL_REPORT_PRICE_FET=0.1
# true: Fetch.ai testnet (dorado, atestfet); false: mainnet (afet)
FET_USE_TESTNET=true
# Optional: a different Cosmos REST endpoint for checking payments
FET_REST_URL=

# Seconds to wait for the API (a first engine run for a new drug can take minutes) and for each specialist
KNOCKOUT_API_TIMEOUT_SECONDS=150
KNOCKOUT_SPECIALIST_TIMEOUT_SECONDS=180

# Optional: ASI:One LLM fallback that only extracts drug and protein names the rules missed (asi1.ai API key)
ASI1_API_KEY=
ASI1_MODEL=asi1

# Optional: ChEMBL and UniProt mirrors for drug and protein lookups
CHEMBL_API_URL=
UNIPROT_API_URL=

# Sentry tracing and logs; nothing is sent when empty
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Where the agents cache ChEMBL and UniProt lookups (default agents/.cache/lookups)
AGENT_CACHE_DIR=
