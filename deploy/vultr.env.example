# Every variable the Vultr deployment reads. On the server:
#   cp deploy/vultr.env.example .env && chmod 600 .env
# then fill in the values. .env is gitignored; never commit it.

# Engine
GEMINI_API_KEY=
GEMINI_MODEL=
OPENFDA_API_KEY=

# Store: for the submission, the Tiger Cloud service's connection string (Tiger Data is a sponsor
# challenge, and only the Postgres store runs the evidence trigger). Empty falls back to JSON files on
# the api-store volume. For the local "db" profile, use
# postgresql://knockout:<POSTGRES_PASSWORD>@timescaledb:5432/knockout
DATABASE_URL=
POSTGRES_PASSWORD=

# Creao watch agent webhook; the same value goes into Creao Secrets. Once set, POST /api/watchlist and
# ?refresh=true also need it in the X-Knockout-Webhook-Secret header.
KNOCKOUT_WEBHOOK_SECRET=
# Optional: POST /api/watchlist starts a Creao run for a newly watched drug
CREAO_API_KEY=
CREAO_AGENT_ID=
# Hours an openFDA response stays cached (default 24)
OPENFDA_CACHE_HOURS=
# Extra browser origins for the API, comma separated (*.vercel.app and localhost:3000 are always allowed)
KNOCKOUT_ALLOWED_ORIGINS=

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=1.0

# Optional services, comma separated: "https" (Caddy), "db" (local TimescaleDB), or "db,https"
COMPOSE_PROFILES=
# Network: the "https" profile needs KNOCKOUT_DOMAIN, and API_BIND=127.0.0.1 keeps port 8000 private
KNOCKOUT_DOMAIN=
API_BIND=0.0.0.0
API_PORT=8000

# Fetch.ai agents: one long random phrase per agent keeps its address stable (see agents/README.md)
AGENT_SEED_ORCHESTRATOR=
AGENT_SEED_TARGET=
AGENT_SEED_GENETICS=
AGENT_SEED_LABEL=
AGENT_SEED_SIGNAL=
AGENT_MAILBOX=true
# Used once by `make deploy-connect-agents` to connect the mailboxes
AGENTVERSE_API_KEY=
KNOCKOUT_REPORT_PAGE_URL=
